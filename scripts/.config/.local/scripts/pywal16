#!/usr/bin/env bash

# Extract current wallpaper from fehbg
if [[ -f "$HOME/.fehbg" ]]; then
    CURRENT_WALLPAPER=$(grep -oP "(?<=')[^']+(?=')" "$HOME/.fehbg" | tail -n1)
fi

# Fallback if fehbg is missing or broken
if [[ -z "$CURRENT_WALLPAPER" || ! -f "$CURRENT_WALLPAPER" ]]; then
    echo "No valid wallpaper found in ~/.fehbg"
    exit 1
fi

wal -i "$CURRENT_WALLPAPER" -q -n
xrdb -merge "$HOME/.cache/wal/colors.Xresources"

# Restart stuff cleanly
pkill dwmblocks 2>/dev/null
dwmblocks &

pkill -USR1 st 2>/dev/null

pkill dunst 2>/dev/null
dunst &
