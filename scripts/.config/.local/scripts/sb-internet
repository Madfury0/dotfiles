#!/bin/sh

case $BLOCK_BUTTON in
    1) "$TERMINAL" -e nmtui; pkill -RTMIN+4 dwmblocks ;;
    3) notify-send "🌐 internet module" "\
- click to connect
󰖪: wifi off
󰖩: wifi connected
󰖪: : wifi disconnected
󰈀: ethernet connected
󰌙: ethernet disconnected
󰒘: vpn active
" ;;
    6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Load theme (for display function)

# Get active connections
active="$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device)"

wifiicon=""
ethericon=""
vpnicon=""

# --- WIFI ---
wifi_radio="$(nmcli radio wifi)"

if [ "$wifi_radio" = "enabled" ]; then
    wifi_conn="$(printf "%s\n" "$active" | awk -F: '$2=="wifi" && $3=="connected" {print $4}')"

    if [ "$wifi_conn" != "" ]; then
        clean_ssid="$(printf "%s" "$wifi_conn" \
            | sed 's/ [0-9]\+$//' \
            | tr '[:upper:]' '[:lower:]')"
        wifiicon="󰖩  $clean_ssid"
    else
        wifiicon=""
    fi
else
    wifiicon="󰖪"
fi

# --- ETHERNET ---
if printf "%s\n" "$active" | awk -F: '$2=="ethernet" && $3=="connected"' | grep -q .; then
    ethericon="󰈀    "
else
    ethericon=""
fi

# --- VPN ---
if ip link show tun0 >/dev/null 2>&1; then
    vpnicon="󰒘"
fi

# --- OUTPUT ---
output="$(printf "%s%s%s" "$wifiicon" "$ethericon" "$vpnicon" | tr '[:upper:]' '[:lower:]')"

. sb-theme
display "$output"
